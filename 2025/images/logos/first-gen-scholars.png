<svg width="400" height="400" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="bg8" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#e8eaf6;stop-opacity:0.9" />
      <stop offset="100%" style="stop-color:#c5cae9;stop-opacity:0.6" />
    </radialGradient>
  </defs>
  
  <circle cx="200" cy="200" r="190" fill="url(#bg8)"/>
  
  <!-- Open book -->
  <path d="M 120 200 Q 120 180, 140 180 L 195 180 L 195 280 L 140 280 Q 120 280, 120 260 Z" 
        fill="#5c6bc0" opacity="0.7"/>
  <path d="M 280 200 Q 280 180, 260 180 L 205 180 L 205 280 L 260 280 Q 280 280, 280 260 Z" 
        fill="#7986cb" opacity="0.7"/>
  
  <!-- Page lines -->
  <line x1="150" y1="200" x2="185" y2="200" stroke="#ffffff" stroke-width="2" opacity="0.5"/>
  <line x1="150" y1="215" x2="185" y2="215" stroke="#ffffff" stroke-width="2" opacity="0.5"/>
  <line x1="150" y1="230" x2="185" y2="230" stroke="#ffffff" stroke-width="2" opacity="0.5"/>
  <line x1="215" y1="200" x2="250" y2="200" stroke="#ffffff" stroke-width="2" opacity="0.5"/>
  <line x1="215" y1="215" x2="250" y2="215" stroke="#ffffff" stroke-width="2" opacity="0.5"/>
  <line x1="215" y1="230" x2="250" y2="230" stroke="#ffffff" stroke-width="2" opacity="0.5"/>
  
  <!-- Sprouting ideas -->
  <circle cx="200" cy="140" r="8" fill="#fdd835" opacity="0.8"/>
  <path d="M 200 148 Q 190 160, 195 170" stroke="#66bb6a" stroke-width="3" fill="none" opacity="0.7"/>
  <ellipse cx="192" cy="165" rx="8" ry="12" fill="#81c784" opacity="0.7" transform="rotate(-20 192 165)"/>
  
  <circle cx="180" cy="130" r="6" fill="#ffee58" opacity="0.7"/>
  <path d="M 180 136 Q 175 145, 178 153" stroke="#66bb6a" stroke-width="2.5" fill="none" opacity="0.7"/>
  <ellipse cx="176" cy="150" rx="6" ry="10" fill="#81c784" opacity="0.7" transform="rotate(-15 176 150)"/>
  
  <circle cx="220" cy="130" r="6" fill="#ffee58" opacity="0.7"/>
  <path d="M 220 136 Q 225 145, 222 153" stroke="#66bb6a" stroke-width="2.5" fill="none" opacity="0.7"/>
  <ellipse cx="224" cy="150" rx="6" ry="10" fill="#81c784" opacity="0.7" transform="rotate(15 224 150)"/>
  
  <!-- Light rays -->
  <path d="M 200 140 L 200 110" stroke="#fdd835" stroke-width="3" opacity="0.5" stroke-linecap="round"/>
  <path d="M 215 145 L 230 130" stroke="#fdd835" stroke-width="2.5" opacity="0.5" stroke-linecap="round"/>
  <path d="M 185 145 L 170 130" stroke="#fdd835" stroke-width="2.5" opacity="0.5" stroke-linecap="round"/>
</svg>



