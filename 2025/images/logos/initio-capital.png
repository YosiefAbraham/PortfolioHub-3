<svg width="400" height="400" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="bg4" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#e8f5e9;stop-opacity:0.9" />
      <stop offset="100%" style="stop-color:#c8e6c9;stop-opacity:0.6" />
    </radialGradient>
  </defs>
  
  <circle cx="200" cy="200" r="190" fill="url(#bg4)"/>
  
  <!-- Sprouting seedling -->
  <ellipse cx="200" cy="280" rx="25" ry="15" fill="#8d6e63" opacity="0.7"/>
  <rect x="195" y="230" width="10" height="50" rx="5" fill="#689f38" opacity="0.8"/>
  
  <!-- Leaves -->
  <ellipse cx="175" cy="220" rx="20" ry="35" fill="#81c784" opacity="0.8" transform="rotate(-30 175 220)"/>
  <ellipse cx="225" cy="220" rx="20" ry="35" fill="#66bb6a" opacity="0.8" transform="rotate(30 225 220)"/>
  <ellipse cx="190" cy="190" rx="18" ry="32" fill="#a5d6a7" opacity="0.8" transform="rotate(-20 190 190)"/>
  <ellipse cx="210" cy="190" rx="18" ry="32" fill="#a5d6a7" opacity="0.8" transform="rotate(20 210 190)"/>
  
  <!-- Upward arrows (growth) -->
  <path d="M 260 220 L 260 170 L 245 185 M 260 170 L 275 185" 
        stroke="#4caf50" stroke-width="6" fill="none" 
        stroke-linecap="round" stroke-linejoin="round" opacity="0.7"/>
  <path d="M 140 240 L 140 190 L 125 205 M 140 190 L 155 205" 
        stroke="#66bb6a" stroke-width="6" fill="none" 
        stroke-linecap="round" stroke-linejoin="round" opacity="0.7"/>
  
  <!-- Decorative dots -->
  <circle cx="200" cy="160" r="5" fill="#81c784" opacity="0.6"/>
  <circle cx="215" cy="170" r="4" fill="#a5d6a7" opacity="0.6"/>
  <circle cx="185" cy="165" r="4" fill="#a5d6a7" opacity="0.6"/>
</svg>



