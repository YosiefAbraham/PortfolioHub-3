<svg width="400" height="400" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
  <!-- Background soft gradient -->
  <defs>
    <radialGradient id="bg1" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#fff5e6;stop-opacity:0.9" />
      <stop offset="100%" style="stop-color:#ffecb3;stop-opacity:0.6" />
    </radialGradient>
  </defs>
  
  <circle cx="200" cy="200" r="190" fill="url(#bg1)"/>
  
  <!-- Music note with cultural ribbons -->
  <ellipse cx="160" cy="240" rx="35" ry="35" fill="#ff6f00" opacity="0.8"/>
  <rect x="190" y="140" width="12" height="105" rx="6" fill="#ff6f00" opacity="0.8"/>
  <circle cx="220" cy="145" r="25" fill="#ff6f00" opacity="0.8"/>
  
  <!-- Flowing ribbons -->
  <path d="M 240 150 Q 280 170, 260 210 Q 240 250, 270 280" 
        stroke="#d32f2f" stroke-width="8" fill="none" 
        stroke-linecap="round" opacity="0.7"/>
  <path d="M 250 155 Q 290 180, 270 220 Q 250 260, 280 290" 
        stroke="#fbc02d" stroke-width="8" fill="none" 
        stroke-linecap="round" opacity="0.7"/>
  <path d="M 135 250 Q 95 280, 120 310 Q 145 340, 110 360" 
        stroke="#388e3c" stroke-width="8" fill="none" 
        stroke-linecap="round" opacity="0.7"/>
  
  <!-- Decorative dots -->
  <circle cx="240" cy="120" r="6" fill="#ff6f00" opacity="0.6"/>
  <circle cx="260" cy="135" r="5" fill="#d32f2f" opacity="0.6"/>
  <circle cx="150" cy="200" r="5" fill="#fbc02d" opacity="0.6"/>
</svg>



