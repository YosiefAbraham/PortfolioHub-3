<svg width="400" height="400" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="bg7" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#fff8e1;stop-opacity:0.9" />
      <stop offset="100%" style="stop-color:#ffecb3;stop-opacity:0.6" />
    </radialGradient>
  </defs>
  
  <circle cx="200" cy="200" r="190" fill="url(#bg7)"/>
  
  <!-- Coffee plant with cultural colors -->
  <rect x="195" y="220" width="10" height="90" rx="5" fill="#6d4c41" opacity="0.8"/>
  
  <!-- Leaves (green) -->
  <ellipse cx="175" cy="240" rx="18" ry="35" fill="#66bb6a" opacity="0.8" transform="rotate(-25 175 240)"/>
  <ellipse cx="225" cy="240" rx="18" ry="35" fill="#66bb6a" opacity="0.8" transform="rotate(25 225 240)"/>
  <ellipse cx="180" cy="270" rx="16" ry="32" fill="#81c784" opacity="0.8" transform="rotate(-30 180 270)"/>
  <ellipse cx="220" cy="270" rx="16" ry="32" fill="#81c784" opacity="0.8" transform="rotate(30 220 270)"/>
  
  <!-- Coffee berries (red) -->
  <circle cx="170" cy="250" r="8" fill="#d32f2f" opacity="0.8"/>
  <circle cx="230" cy="250" r="8" fill="#d32f2f" opacity="0.8"/>
  <circle cx="175" cy="280" r="7" fill="#e53935" opacity="0.8"/>
  <circle cx="225" cy="280" r="7" fill="#e53935" opacity="0.8"/>
  
  <!-- Cultural color bands (Ethiopian flag colors) -->
  <rect x="140" y="140" width="120" height="15" rx="7" fill="#66bb6a" opacity="0.7"/>
  <rect x="140" y="160" width="120" height="15" rx="7" fill="#fdd835" opacity="0.7"/>
  <rect x="140" y="180" width="120" height="15" rx="7" fill="#d32f2f" opacity="0.7"/>
  
  <!-- Star accent -->
  <path d="M 200 165 L 205 175 L 215 175 L 207 182 L 210 192 L 200 185 L 190 192 L 193 182 L 185 175 L 195 175 Z" 
        fill="#fdd835" opacity="0.8"/>
</svg>



