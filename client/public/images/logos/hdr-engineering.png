<svg width="400" height="400" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="bg6" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#e3f2fd;stop-opacity:0.9" />
      <stop offset="100%" style="stop-color:#bbdefb;stop-opacity:0.6" />
    </radialGradient>
  </defs>
  
  <circle cx="200" cy="200" r="190" fill="url(#bg6)"/>
  
  <!-- Soft landscape/hills -->
  <ellipse cx="200" cy="320" rx="180" ry="50" fill="#a5d6a7" opacity="0.6"/>
  <ellipse cx="220" cy="310" rx="120" ry="40" fill="#81c784" opacity="0.5"/>
  
  <!-- Bridge structure -->
  <rect x="80" y="240" width="240" height="12" rx="3" fill="#546e7a" opacity="0.8"/>
  
  <!-- Bridge supports -->
  <rect x="120" y="252" width="8" height="60" fill="#455a64" opacity="0.8"/>
  <rect x="190" y="252" width="8" height="60" fill="#455a64" opacity="0.8"/>
  <rect x="260" y="252" width="8" height="60" fill="#455a64" opacity="0.8"/>
  
  <!-- Cable curves -->
  <path d="M 80 240 Q 150 180, 200 180 Q 250 180, 320 240" 
        stroke="#607d8b" stroke-width="3" fill="none" opacity="0.7"/>
  <line x1="124" y1="185" x2="124" y2="252" stroke="#78909c" stroke-width="2" opacity="0.6"/>
  <line x1="194" y1="180" x2="194" y2="252" stroke="#78909c" stroke-width="2" opacity="0.6"/>
  <line x1="264" y1="185" x2="264" y2="252" stroke="#78909c" stroke-width="2" opacity="0.6"/>
  
  <!-- Rail tracks below -->
  <line x1="100" y1="280" x2="300" y2="280" stroke="#8d6e63" stroke-width="4" opacity="0.7"/>
  <line x1="100" y1="290" x2="300" y2="290" stroke="#8d6e63" stroke-width="4" opacity="0.7"/>
  <line x1="120" y1="280" x2="120" y2="290" stroke="#8d6e63" stroke-width="3" opacity="0.7"/>
  <line x1="160" y1="280" x2="160" y2="290" stroke="#8d6e63" stroke-width="3" opacity="0.7"/>
  <line x1="200" y1="280" x2="200" y2="290" stroke="#8d6e63" stroke-width="3" opacity="0.7"/>
  <line x1="240" y1="280" x2="240" y2="290" stroke="#8d6e63" stroke-width="3" opacity="0.7"/>
  <line x1="280" y1="280" x2="280" y2="290" stroke="#8d6e63" stroke-width="3" opacity="0.7"/>
</svg>



