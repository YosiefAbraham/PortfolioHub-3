<svg width="400" height="400" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="bg3" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#fff9c4;stop-opacity:0.9" />
      <stop offset="100%" style="stop-color:#fff59d;stop-opacity:0.6" />
    </radialGradient>
  </defs>
  
  <circle cx="200" cy="200" r="190" fill="url(#bg3)"/>
  
  <!-- Soft clouds -->
  <ellipse cx="150" cy="250" rx="50" ry="30" fill="#e1f5fe" opacity="0.8"/>
  <ellipse cx="190" cy="260" rx="45" ry="28" fill="#e1f5fe" opacity="0.8"/>
  <ellipse cx="220" cy="255" rx="55" ry="32" fill="#e1f5fe" opacity="0.8"/>
  <ellipse cx="260" cy="250" rx="48" ry="30" fill="#e1f5fe" opacity="0.8"/>
  
  <!-- Light bulb breaking through -->
  <circle cx="200" cy="180" r="45" fill="#fff9c4" opacity="0.9" stroke="#fdd835" stroke-width="3"/>
  <rect x="185" y="225" width="30" height="15" rx="3" fill="#9e9e9e" opacity="0.7"/>
  <rect x="190" y="240" width="20" height="8" rx="2" fill="#757575" opacity="0.7"/>
  
  <!-- Light rays -->
  <path d="M 200 135 L 200 105" stroke="#fdd835" stroke-width="4" stroke-linecap="round" opacity="0.6"/>
  <path d="M 245 158 L 265 138" stroke="#fdd835" stroke-width="4" stroke-linecap="round" opacity="0.6"/>
  <path d="M 155 158 L 135 138" stroke="#fdd835" stroke-width="4" stroke-linecap="round" opacity="0.6"/>
  <path d="M 255 180 L 285 180" stroke="#fdd835" stroke-width="4" stroke-linecap="round" opacity="0.6"/>
  <path d="M 145 180 L 115 180" stroke="#fdd835" stroke-width="4" stroke-linecap="round" opacity="0.6"/>
  
  <!-- Sparkles -->
  <circle cx="230" cy="150" r="4" fill="#fdd835" opacity="0.8"/>
  <circle cx="170" cy="155" r="3" fill="#fdd835" opacity="0.8"/>
  <circle cx="200" cy="130" r="3" fill="#fff9c4" opacity="0.9"/>
</svg>



