<svg width="400" height="400" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="bg5" cx="50%" cy="50%" r="50%">
      <stop offset="0%" style="stop-color:#f3e5f5;stop-opacity:0.9" />
      <stop offset="100%" style="stop-color:#e1bee7;stop-opacity:0.6" />
    </radialGradient>
  </defs>
  
  <circle cx="200" cy="200" r="190" fill="url(#bg5)"/>
  
  <!-- Interconnected nodes -->
  <circle cx="200" cy="150" r="25" fill="#ba68c8" opacity="0.8"/>
  <circle cx="150" cy="220" r="25" fill="#ce93d8" opacity="0.8"/>
  <circle cx="250" cy="220" r="25" fill="#ce93d8" opacity="0.8"/>
  <circle cx="170" cy="280" r="22" fill="#e1bee7" opacity="0.8"/>
  <circle cx="230" cy="280" r="22" fill="#e1bee7" opacity="0.8"/>
  
  <!-- Connecting lines -->
  <line x1="200" y1="175" x2="160" y2="200" stroke="#ab47bc" stroke-width="4" opacity="0.6" stroke-linecap="round"/>
  <line x1="200" y1="175" x2="240" y2="200" stroke="#ab47bc" stroke-width="4" opacity="0.6" stroke-linecap="round"/>
  <line x1="150" y1="245" x2="175" y2="265" stroke="#ba68c8" stroke-width="4" opacity="0.6" stroke-linecap="round"/>
  <line x1="250" y1="245" x2="225" y2="265" stroke="#ba68c8" stroke-width="4" opacity="0.6" stroke-linecap="round"/>
  <line x1="170" y1="258" x2="230" y2="258" stroke="#ce93d8" stroke-width="3" opacity="0.5" stroke-linecap="round"/>
  
  <!-- Small accent circles -->
  <circle cx="200" cy="150" r="12" fill="#ffffff" opacity="0.6"/>
  <circle cx="150" cy="220" r="12" fill="#ffffff" opacity="0.5"/>
  <circle cx="250" cy="220" r="12" fill="#ffffff" opacity="0.5"/>
</svg>



